    );

    initial {
        zero_audio.raw = 0;

        rst.assert();
        clk.next(4);

        for _ in 0..CAPTURE_CHUNKS {
            clk.next(CHUNK_CYCLES);
        }

        $finish();
    }
}

// CV・ENVの全入力bitを保持し、平均密度と負端点への応答を検証。
#[test(test_delta_sigma_1st_cv)]
module test_delta_sigma_1st_cv {
    inst clk  : $tb::clock_gen;
    inst rst  : $tb::reset_gen ( clk );
    inst audio: FixedPointValue::<Q1_31>;
    var pdm: logic;
    inst dut: DeltaSigma1st ( clk, rst, audio, pdm );
    var random: $tb::random::<u32>;
    initial {
        var sum     : logic<64>;
        var ones    : u64      ;
        var expected: logic<33>;
        random.seed(73);
        sum       = 0;
        ones      = 0;
        expected  = 0;
        audio.raw = 0;
        rst.assert();
        for _ in 0..65536 {
            audio.raw = random.get();
            let offset   : logic<32> = {~audio.raw[31], audio.raw[30:0]};
            sum       += offset as 64;
            expected  =  (expected[31:0] as 33) + (offset as 33);
            clk.next();
            $assert(pdm == expected[32], "CV carry mismatch");
            $assert(dut.accumulator == expected, "CV input precision mismatch");
            if pdm {
                ones += 1;
            }
        }
        $assert(ones == (sum >> 32), "CV mean density mismatch");
        audio.raw = Q1_31::MAX;
        clk.next(2);
        $assert(pdm, "positive endpoint");
        audio.raw = Q1_31::MIN;
        clk.next();
        $assert(!pdm, "negative endpoint must take effect at next edge");
        $finish();
    }
}

// 2次の入力下位bitを切り捨てず状態へ取り込むことを検証。
#[test(test_delta_sigma_2nd_input_precision)]
module test_delta_sigma_2nd_input_precision {
    inst clk  : $tb::clock_gen;
    inst rst  : $tb::reset_gen ( clk );
    inst audio: FixedPointValue::<Q1_31>;
    var pdm: logic;
    inst dut: DeltaSigma2nd ( clk, rst, audio, pdm );
    initial {
        audio.raw = 1;
        rst.assert();
        clk.next();
        $assert(dut.integrator_1 == 38'sd4294967297, "2nd lost input LSB");
        $assert(dut.integrator_2 == 38'sd8589934593, "2nd lost input LSB in second state");
        clk.next();
        $assert(dut.integrator_1 == 38'sd2, "2nd input LSB accumulation");
        $assert(pdm, "2nd quantizer sign");
        $finish();
    }
}

// DC入力に対するディザの累積寄与が±4 LSB以内で、resetで乱数位相が復元されることを検証。
#[test(test_delta_sigma_2nd_dc_dither)]
module test_delta_sigma_2nd_dc_dither {
    inst clk  : $tb::clock_gen;
    inst rst  : $tb::reset_gen ( clk );
    inst audio: FixedPointValue::<Q1_31>;
    var pdm: logic;
    inst dut: DeltaSigma2nd #( DITHER_SEED: 32'd1 ) ( clk, rst, audio, pdm );
    initial {
        audio.raw = 32;
        rst.assert();
        for _ in 0..2 {
            var input_sum   : i64;
            var feedback_sum: i64;
            var ones        : u32;
            var excursions  : u32;
            input_sum    = 0;
            feedback_sum = 0;
            ones         = 0;
            excursions   = 0;
            $assert(dut.dither_prng == 32'd1, "2nd dither reset seed");
            for _ in 0..65536 {
                input_sum    += 32;
                feedback_sum += if pdm ? 64'sd4294967296 : -64'sd4294967296;
                clk.next();
                let residual: i64 = (dut.integrator_1 as i64) - input_sum + feedback_sum;
                $assert(residual >= -64'sd4 && residual <= 64'sd4, "2nd dither accumulated DC offset");
                if residual != 0 {
                    excursions += 1;
                }
                if pdm {
                    ones += 1;
                }
            }
            $assert(excursions >: 1000, "2nd dither did not perturb DC state");
            $assert(ones >: 32760 && ones <: 32776, "2nd dither DC density");
            rst.assert();
        }
        $finish();
    }
}

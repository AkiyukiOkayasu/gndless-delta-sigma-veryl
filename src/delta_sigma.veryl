import gndless_fixedpoint::FixedPointValue;
import gndless_fixedpoint::Q1_31;

/// 1次1bitデルタシグマ変調器
///
/// PCMを1bit PDMへ変換する。
/// 入力は`FixedPointValue::<Q1_31>`（-1.0以上、+1.0未満）とする。
/// Q1.31入力を毎posedgeで取り込み、直後に登録PDMを更新する。
/// pdmを1=+1、0=-1として復調したときの利得は1。
/// DC・微小入力では周期的な成分が残る場合がある。
/// reset中のpdm=0は復調値0ではないため、必要な出力ミュートは利用側で行う。
pub module DeltaSigma1st (
    clk  : input   clock                               , /// PDM更新クロック
    rst  : input   reset                               , /// 変調状態とpdmを0に初期化
    audio: modport FixedPointValue::<Q1_31>::input_port, /// 全32bitを使用するQ1.31入力（-1以上1未満）
    pdm  : output  logic                               , /// 登録PDM出力、入力0での平均密度は0.5
) {
    var accumulator: logic<33>;

    assign pdm = accumulator[32];

    always_ff {
        if_reset {
            accumulator = 0;
        } else {
            let audio_unsigned: logic<32> = {~audio.raw[31], audio.raw[30:0]};
            accumulator    = (accumulator[31:0] as 33) + (audio_unsigned as 33);
        }
    }
}

/// 2次デルタシグマ変調器
///
/// 2段の積分器を持つ簡易構成で、1次変調器より高い帯域外ノイズシェーピングを得る。
/// 入力Q1.31は1/4にスケールするため、フルスケール入力のPDM密度は約0.25/0.75になる。
/// 内部演算は36bit signedとする。
/// 入力±2^29、帰還±2^30に対し積分器の実振幅は最大~2^32程度であり、±2^35の範囲に4倍以上のヘッドルームを持たせている（旧実装の40bitはこの2倍を超える過剰幅だった）。
/// 無音時の決定論的なアイドルトーンを防ぐため、変調器入力へ±1 LSBのハイパスTPDFディザを加える。
pub module DeltaSigma2nd #(
    param DITHER_SEED: u32 = 32'h1A2B_3C4D, /// ハイパスTPDFディザ用LFSRの非ゼロ初期値
) (
    clk  : input   clock                               , /// システムクロック
    rst  : input   reset                               , /// リセット
    audio: modport FixedPointValue::<Q1_31>::input_port, /// Q1.31入力サンプル
    pdm  : output  logic                               , /// 1bit PDM出力
) {
    var integrator_1: signed logic<36>;
    var integrator_2: signed logic<36>;

    // PDM帰還値は正負を完全に対称にする。
    const FEEDBACK_POS: signed logic<36> = 1073741824;
    const FEEDBACK_NEG: signed logic<36> = -1073741824;

    // 32bit maximal-length LFSR。
    // 現在値と1クロック前のベルヌーイ乱数の差分で、-1/0/+1 LSB（1:2:1）のハイパスTPDFディザを構成する。
    var dither_prng         : logic<32>;
    var dither_prng_previous: logic    ;
    var dither_seed_pending : logic    ;
    var dither_valid        : logic    ;
    inst dither_lfsr: $std::lfsr_galois #(
        SIZE: 32,
    ) (
        i_clk: clk ,
        i_en : 1'b1,
        // `if_reset`で立てた要求により、`reset`の極性に依存せずseedをロードする。
        i_set   : dither_seed_pending,
        i_setval: DITHER_SEED        ,
        o_val   : dither_prng        ,
    );

    always_ff {
        if_reset {
            integrator_1         = 0;
            integrator_2         = 0;
            pdm                  = 1'b0;
            dither_seed_pending  = 1'b1;
            dither_valid         = 1'b0;
            dither_prng_previous = 1'b0;
        } else {
            // 同一format内の内部スケールなので、raw値へ直接算術右シフトする
            let audio_scaled     : signed logic<32> = $signed(audio.raw) >>> 2;
            let dither_current   : signed logic<3>  = if dither_prng[0] ? 3'sd1 : 3'sd0;
            let dither_previous  : signed logic<3>  = if dither_prng_previous ? 3'sd1 : 3'sd0;
            let dither           : signed logic<3>  = if dither_valid ? dither_current - dither_previous : 3'sd0;
            let audio_ext        : signed logic<36> = $signed({audio_scaled[31] repeat 4, audio_scaled});
            let dither_ext       : signed logic<36> = $signed({dither[2] repeat 33, dither});
            let input_ext        : signed logic<36> = audio_ext + dither_ext;
            let feedback         : signed logic<36> = if pdm ? FEEDBACK_POS : FEEDBACK_NEG;
            let integrator_1_next: signed logic<36> = integrator_1 + (input_ext - feedback);
            let integrator_2_next: signed logic<36> = integrator_2 + (integrator_1_next - feedback);

            integrator_1        = integrator_1_next;
            integrator_2        = integrator_2_next;
            pdm                 = ~integrator_2_next[35];
            dither_seed_pending = 1'b0;
            dither_valid        = 1'b1;
            if dither_valid {
                dither_prng_previous = dither_prng[0];
            }
        }
    }
}

// 1次デルタシグマ変調器の出力密度が入力振幅に追従することを検証
#[test(test_delta_sigma_1st_density)]
module test_delta_sigma_1st_density {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst zero_audio    : FixedPointValue::<Q1_31>;
    inst positive_audio: FixedPointValue::<Q1_31>;
    inst negative_audio: FixedPointValue::<Q1_31>;
    var zero_pdm     : logic   ;
    var positive_pdm : logic   ;
    var negative_pdm : logic   ;
    var zero_ones    : logic<8>;
    var positive_ones: logic<8>;
    var negative_ones: logic<8>;

    inst zero: DeltaSigma1st (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : zero_pdm  ,
    );
    inst positive: DeltaSigma1st (
        clk  : clk           ,
        rst  : rst           ,
        audio: positive_audio,
        pdm  : positive_pdm  ,
    );
    inst negative: DeltaSigma1st (
        clk  : clk           ,
        rst  : rst           ,
        audio: negative_audio,
        pdm  : negative_pdm  ,
    );

    always_ff (clk, rst) {
        if_reset {
            zero_ones     = 0;
            positive_ones = 0;
            negative_ones = 0;
        } else {
            if zero_pdm {
                zero_ones = zero_ones + 1;
            }
            if positive_pdm {
                positive_ones = positive_ones + 1;
            }
            if negative_pdm {
                negative_ones = negative_ones + 1;
            }
        }
    }

    initial {
        zero_audio.raw     = 0;
        positive_audio.raw = Q1_31::MAX;
        negative_audio.raw = Q1_31::MIN;
        rst.assert();
        clk.next(64);

        $assert(zero_ones >: 8'd24 && zero_ones <: 8'd40, "1st order zero density mismatch");
        $assert(positive_ones >: 8'd56, "1st order positive density is too low");
        $assert(negative_ones <: 8'd8, "1st order negative density is too high");
        $finish();
    }
}

/// 2次デルタシグマ変調器の出力密度が入力振幅に追従することを検証
#[test(test_delta_sigma_2nd_density)]
module test_delta_sigma_2nd_density {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst zero_audio    : FixedPointValue::<Q1_31>;
    inst positive_audio: FixedPointValue::<Q1_31>;
    inst negative_audio: FixedPointValue::<Q1_31>;
    var zero_pdm     : logic   ;
    var positive_pdm : logic   ;
    var negative_pdm : logic   ;
    var zero_ones    : logic<8>;
    var positive_ones: logic<8>;
    var negative_ones: logic<8>;

    inst zero: DeltaSigma2nd (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : zero_pdm  ,
    );
    inst positive: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: positive_audio,
        pdm  : positive_pdm  ,
    );
    inst negative: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: negative_audio,
        pdm  : negative_pdm  ,
    );

    always_ff (clk, rst) {
        if_reset {
            zero_ones     = 0;
            positive_ones = 0;
            negative_ones = 0;
        } else {
            if zero_pdm {
                zero_ones = zero_ones + 1;
            }
            if positive_pdm {
                positive_ones = positive_ones + 1;
            }
            if negative_pdm {
                negative_ones = negative_ones + 1;
            }
        }
    }

    initial {
        zero_audio.raw     = 0;
        positive_audio.raw = Q1_31::MAX;
        negative_audio.raw = Q1_31::MIN;
        rst.assert();
        clk.next(128);

        $assert(zero_ones >: 8'd40 && zero_ones <: 8'd88, "2nd order zero density mismatch");
        $assert(positive_ones >: 8'd88, "2nd order positive density is too low");
        $assert(negative_ones <: 8'd40, "2nd order negative density is too high");
        $finish();
    }
}

/// 2次デルタシグマ変調器がフルスケール入力で長時間stuckしないことを検証
///
/// 入力Q1.31は1/4にスケールされるため、+MAXの密度は約0.75、MINは約0.25になる。
#[test(test_delta_sigma_2nd_full_scale)]
module test_delta_sigma_2nd_full_scale {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst positive_audio: FixedPointValue::<Q1_31>;
    inst negative_audio: FixedPointValue::<Q1_31>;
    var positive_pdm : logic;
    var negative_pdm : logic;
    var positive_ones: u16  ;
    var negative_ones: u16  ;

    inst positive: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: positive_audio,
        pdm  : positive_pdm  ,
    );
    inst negative: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: negative_audio,
        pdm  : negative_pdm  ,
    );

    always_ff (clk, rst) {
        if_reset {
            positive_ones = 0;
            negative_ones = 0;
        } else {
            if positive_pdm {
                positive_ones += 1;
            }
            if negative_pdm {
                negative_ones += 1;
            }
        }
    }

    initial {
        positive_audio.raw = Q1_31::MAX;
        negative_audio.raw = Q1_31::MIN;
        rst.assert();
        clk.next(4096);

        $assert(positive_ones >: 16'd2500 && positive_ones <: 16'd3600, "positive full-scale density mismatch");
        $assert(negative_ones >: 16'd500 && negative_ones <: 16'd1600, "negative full-scale density mismatch");
        $finish();
    }
}

// 1次デルタシグマ変調器の無音時アイドルトーンを検査するネイティブテスト
//
// 50MHzで44秒間（22億clock）を実行する。
// PDMを3段CICで1/1024に間引き、Rust verification componentで20Hzから20kHzの狭帯域トーンを検出する。
// 長時間のため通常のtestからは除外する。
#[test(test_delta_sigma_1st_idle_capture)]
#[ignore]
module test_delta_sigma_1st_idle_capture {
    const CAPTURE_CHUNKS: u32 = 22;
    const CHUNK_CYCLES  : u32 = 100_000_000;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst zero_audio: FixedPointValue::<Q1_31>;
    var pdm: logic;

    inst dut: DeltaSigma1st (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : pdm       ,
    );

    inst idle_tone_checker: $comp::idle_tone_checker (
        clk: clk,
        rst: rst,
        pdm: pdm,
    );

    initial {
        zero_audio.raw = 0;

        rst.assert();
        clk.next(4);

        for _ in 0..CAPTURE_CHUNKS {
            clk.next(CHUNK_CYCLES);
        }

        $finish();
    }
}

/// 2次デルタシグマ変調器の無音時アイドルトーンを検査するネイティブテスト
///
/// 50MHzで44秒間（22億clock）を実行する。
/// PDMを3段CICで1/1024に間引き、Rust verification componentで20Hzから20kHzの狭帯域トーンを検出する。
/// 長時間のため通常のtestからは除外する。
#[test(test_delta_sigma_2nd_idle_capture)]
#[ignore]
module test_delta_sigma_2nd_idle_capture {
    const CAPTURE_CHUNKS: u32 = 22;
    const CHUNK_CYCLES  : u32 = 100_000_000;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst zero_audio: FixedPointValue::<Q1_31>;
    var pdm: logic;

    inst dut: DeltaSigma2nd (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : pdm       ,
    );

    inst idle_tone_checker: $comp::idle_tone_checker (
        clk: clk,
        rst: rst,
        pdm: pdm,
    );

    initial {
        zero_audio.raw = 0;

        rst.assert();
        clk.next(4);

        for _ in 0..CAPTURE_CHUNKS {
            clk.next(CHUNK_CYCLES);
        }

        $finish();
    }
}

// CV・ENVの全入力bitを保持し、平均密度と負端点への応答を検証。
#[test(test_delta_sigma_1st_cv)]
module test_delta_sigma_1st_cv {
    inst clk  : $tb::clock_gen;
    inst rst  : $tb::reset_gen ( clk );
    inst audio: FixedPointValue::<Q1_31>;
    var pdm: logic;
    inst dut: DeltaSigma1st ( clk, rst, audio, pdm );
    var random: $tb::random::<u32>;
    initial {
        var sum     : logic<64>;
        var ones    : u64      ;
        var expected: logic<33>;
        random.seed(73);
        sum       = 0;
        ones      = 0;
        expected  = 0;
        audio.raw = 0;
        rst.assert();
        for _ in 0..65536 {
            audio.raw = random.get();
            let offset   : logic<32> = {~audio.raw[31], audio.raw[30:0]};
            sum       += offset as 64;
            expected  =  (expected[31:0] as 33) + (offset as 33);
            clk.next();
            $assert(pdm == expected[32], "CV carry mismatch");
            $assert(dut.accumulator == expected, "CV input precision mismatch");
            if pdm {
                ones += 1;
            }
        }
        $assert(ones == (sum >> 32), "CV mean density mismatch");
        audio.raw = Q1_31::MAX;
        clk.next(2);
        $assert(pdm, "positive endpoint");
        audio.raw = Q1_31::MIN;
        clk.next();
        $assert(!pdm, "negative endpoint must take effect at next edge");
        $finish();
    }
}

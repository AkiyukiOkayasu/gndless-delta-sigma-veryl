/// PCMを1bit PDMへ変換するデルタシグマ変調器
/// 入力はgndless_fixedpoint::Q1_31::Raw（-1.0以上、+1.0未満）とする。

/// 1次デルタシグマ変調器
///
/// キャリー・アキュムレータ形式で実装し、入力のDC値に比例したPDM密度を得る。
/// `pdm`は`clk`ごとに1bit更新される。
pub module DeltaSigma1st (
    clk  : input  clock                         , /// システムクロック
    rst  : input  reset                         , /// リセット
    audio: input  gndless_fixedpoint::Q1_31::Raw, /// Q1.31入力サンプル
    pdm  : output logic                         , /// 1bit PDM出力
) {
    var accumulator: logic<33>;

    always_ff {
        if_reset {
            accumulator = 0;
            pdm         = 1'b0;
        } else {
            let audio_unsigned: logic<32> = {~audio[31], audio[30:0]};
            accumulator    = (accumulator[31:0] as 33) + (audio_unsigned as 33);
            pdm            = accumulator[32];
        }
    }
}

/// 2次デルタシグマ変調器
///
/// 2段の積分器を持つ簡易構成で、1次変調器より高い帯域外ノイズシェーピングを得る。
/// 内部演算は余裕を持たせた40bit signedとする。無音時の決定論的な
/// アイドルトーンを防ぐため、変調器入力へ±1 LSBのハイパスTPDFディザを加える。
pub module DeltaSigma2nd #(
    /// ハイパスTPDFディザ用LFSRの非ゼロ初期値。
    param DITHER_SEED: u32 = 32'h1A2B_3C4D,
) (
    clk  : input  clock                         , /// システムクロック
    rst  : input  reset                         , /// リセット
    audio: input  gndless_fixedpoint::Q1_31::Raw, /// Q1.31入力サンプル
    pdm  : output logic                         , /// 1bit PDM出力
) {
    var integrator_1: signed logic<40>;
    var integrator_2: signed logic<40>;

    // PDM帰還値は正負を完全に対称にする。
    const FEEDBACK_POS: signed logic<40> = 1073741824;
    const FEEDBACK_NEG: signed logic<40> = -1073741824;

    // 32bit maximal-length LFSR。現在値と1クロック前のベルヌーイ乱数の差分で、
    // -1/0/+1 LSB（1:2:1）のハイパスTPDFディザを構成する。
    var dither_prng         : logic<32>;
    var dither_prng_previous: logic    ;
    var dither_seed_pending : logic    ;
    var dither_valid        : logic    ;
    inst dither_lfsr: $std::lfsr_galois #(
        SIZE: 32,
    ) (
        i_clk: clk ,
        i_en : 1'b1,
        // `if_reset`で立てた要求により、`reset`の極性に依存せずseedをロードする。
        i_set   : dither_seed_pending,
        i_setval: DITHER_SEED        ,
        o_val   : dither_prng        ,
    );

    always_ff {
        if_reset {
            integrator_1         = 0;
            integrator_2         = 0;
            pdm                  = 1'b0;
            dither_seed_pending  = 1'b1;
            dither_valid         = 1'b0;
            dither_prng_previous = 1'b0;
        } else {
            // 同一format内の内部スケールなので、raw値へ直接算術右シフトする
            let audio_scaled     : signed logic<32> = $signed(audio) >>> 2;
            let dither_current   : signed logic<3>  = if dither_prng[0] ? 3'sd1 : 3'sd0;
            let dither_previous  : signed logic<3>  = if dither_prng_previous ? 3'sd1 : 3'sd0;
            let dither           : signed logic<3>  = if dither_valid ? dither_current - dither_previous : 3'sd0;
            let audio_ext        : signed logic<40> = $signed({audio_scaled[31] repeat 8, audio_scaled});
            let dither_ext       : signed logic<40> = $signed({dither[2] repeat 37, dither});
            let input_ext        : signed logic<40> = audio_ext + dither_ext;
            let feedback         : signed logic<40> = if pdm ? FEEDBACK_POS : FEEDBACK_NEG;
            let integrator_1_next: signed logic<40> = integrator_1 + (input_ext - feedback);
            let integrator_2_next: signed logic<40> = integrator_2 + (integrator_1_next - feedback);

            integrator_1        = integrator_1_next;
            integrator_2        = integrator_2_next;
            pdm                 = ~integrator_2_next[39];
            dither_seed_pending = 1'b0;
            dither_valid        = 1'b1;
            if dither_valid {
                dither_prng_previous = dither_prng[0];
            }
        }
    }
}

/// 1次デルタシグマ変調器の出力密度が入力振幅に追従することを検証
#[test(test_delta_sigma_1st_density)]
module test_delta_sigma_1st_density {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var zero_audio    : gndless_fixedpoint::Q1_31::Raw   ;
    var positive_audio: gndless_fixedpoint::Q1_31::Raw   ;
    var negative_audio: gndless_fixedpoint::Q1_31::Raw   ;
    var zero_pdm      : logic                            ;
    var positive_pdm  : logic                            ;
    var negative_pdm  : logic                            ;
    var zero_ones     : logic                         <8>;
    var positive_ones : logic                         <8>;
    var negative_ones : logic                         <8>;

    inst zero: DeltaSigma1st (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : zero_pdm  ,
    );
    inst positive: DeltaSigma1st (
        clk  : clk           ,
        rst  : rst           ,
        audio: positive_audio,
        pdm  : positive_pdm  ,
    );
    inst negative: DeltaSigma1st (
        clk  : clk           ,
        rst  : rst           ,
        audio: negative_audio,
        pdm  : negative_pdm  ,
    );

    always_ff (clk, rst) {
        if_reset {
            zero_ones     = 0;
            positive_ones = 0;
            negative_ones = 0;
        } else {
            if zero_pdm {
                zero_ones = zero_ones + 1;
            }
            if positive_pdm {
                positive_ones = positive_ones + 1;
            }
            if negative_pdm {
                negative_ones = negative_ones + 1;
            }
        }
    }

    initial {
        zero_audio     = 0;
        positive_audio = gndless_fixedpoint::Q1_31::MAX;
        negative_audio = gndless_fixedpoint::Q1_31::MIN;
        rst.assert();
        clk.next(64);

        $assert(zero_ones >: 8'd24 && zero_ones <: 8'd40, "1st order zero density mismatch");
        $assert(positive_ones >: 8'd56, "1st order positive density is too low");
        $assert(negative_ones <: 8'd8, "1st order negative density is too high");
        $finish();
    }
}

/// 2次デルタシグマ変調器の出力密度が入力振幅に追従することを検証
#[test(test_delta_sigma_2nd_density)]
module test_delta_sigma_2nd_density {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var zero_audio    : gndless_fixedpoint::Q1_31::Raw   ;
    var positive_audio: gndless_fixedpoint::Q1_31::Raw   ;
    var negative_audio: gndless_fixedpoint::Q1_31::Raw   ;
    var zero_pdm      : logic                            ;
    var positive_pdm  : logic                            ;
    var negative_pdm  : logic                            ;
    var zero_ones     : logic                         <8>;
    var positive_ones : logic                         <8>;
    var negative_ones : logic                         <8>;

    inst zero: DeltaSigma2nd (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : zero_pdm  ,
    );
    inst positive: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: positive_audio,
        pdm  : positive_pdm  ,
    );
    inst negative: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: negative_audio,
        pdm  : negative_pdm  ,
    );

    always_ff (clk, rst) {
        if_reset {
            zero_ones     = 0;
            positive_ones = 0;
            negative_ones = 0;
        } else {
            if zero_pdm {
                zero_ones = zero_ones + 1;
            }
            if positive_pdm {
                positive_ones = positive_ones + 1;
            }
            if negative_pdm {
                negative_ones = negative_ones + 1;
            }
        }
    }

    initial {
        zero_audio     = 0;
        positive_audio = gndless_fixedpoint::Q1_31::MAX;
        negative_audio = gndless_fixedpoint::Q1_31::MIN;
        rst.assert();
        clk.next(128);

        $assert(zero_ones >: 8'd40 && zero_ones <: 8'd88, "2nd order zero density mismatch");
        $assert(positive_ones >: 8'd88, "2nd order positive density is too low");
        $assert(negative_ones <: 8'd40, "2nd order negative density is too high");
        $finish();
    }
}

/// 1次デルタシグマ変調器の無音時アイドルトーンを検査するネイティブテスト
///
/// 50MHzで44秒間（22億clock）を実行する。PDMを3段CICで1/1024に間引き、
/// Rust verification componentで20Hzから20kHzの狭帯域トーンを検出する。
/// 長時間のため通常のtestからは除外する。
#[test(test_delta_sigma_1st_idle_capture)]
#[ignore]
module test_delta_sigma_1st_idle_capture {
    const CAPTURE_CHUNKS       : u32 = 22;
    const CHUNK_CYCLES         : u32 = 100_000_000;
    const CIC_DECIMATION       : u32 = 1024;
    const CIC_STAGES           : u32 = 3;
    const CIC_INPUT_WIDTH      : u32 = 64;
    const CIC_ACCUMULATOR_WIDTH: u32 = 64;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var zero_audio       : gndless_fixedpoint::Q1_31::Raw                       ;
    var pdm              : logic                                                ;
    var pdm_sample       : signed logic                  <CIC_INPUT_WIDTH>      ;
    var cic_output_valid : bbool                                                ;
    var cic_output_sample: signed logic                  <CIC_ACCUMULATOR_WIDTH>;

    inst dut: DeltaSigma1st (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : pdm       ,
    );

    always_comb {
        pdm_sample = if pdm ? 64'sd1 : -64'sd1;
    }

    inst cic: gndless_filter::CicDecimator #(
        INPUT_WIDTH      : CIC_INPUT_WIDTH      ,
        ACCUMULATOR_WIDTH: CIC_ACCUMULATOR_WIDTH,
        STAGES           : CIC_STAGES           ,
        DECIMATION       : CIC_DECIMATION       ,
    ) (
        clk          : clk              ,
        rst          : rst              ,
        input_valid  : true             ,
        input_sample : pdm_sample       ,
        output_valid : cic_output_valid ,
        output_sample: cic_output_sample,
    );

    inst idle_tone_checker: $comp::idle_tone_checker (
        clk         : clk              ,
        rst         : rst              ,
        sample_valid: cic_output_valid ,
        sample      : cic_output_sample,
    );

    initial {
        zero_audio = 0;

        rst.assert();
        clk.next(4);

        for _ in 0..CAPTURE_CHUNKS {
            clk.next(CHUNK_CYCLES);
        }

        $finish();
    }
}

/// 2次デルタシグマ変調器の無音時アイドルトーンを検査するネイティブテスト
///
/// 50MHzで44秒間（22億clock）を実行する。PDMを3段CICで1/1024に間引き、

import gndless_fixedpoint::FixedPointValue;
import gndless_fixedpoint::Q1_31;

/// 1次1bitデルタシグマ変調器
///
/// PCMを1bit PDMへ変換する。
/// 入力は`FixedPointValue::<Q1_31>`（-1.0以上、+1.0未満）とする。
/// Q1.31入力を毎posedgeで取り込み、直後に登録PDMを更新する。
/// pdmを1=+1、0=-1として復調したときの利得は1。
/// DC・微小入力では周期的な成分が残る場合がある。
/// reset中のpdm=0は復調値0ではないため、必要な出力ミュートは利用側で行う。
pub module DeltaSigma1st (
    clk  : input   clock                               , /// PDM更新クロック
    rst  : input   reset                               , /// 変調状態とpdmを0に初期化
    audio: modport FixedPointValue::<Q1_31>::input_port, /// 全32bitを使用するQ1.31入力（-1以上1未満）
    pdm  : output  logic                               , /// 登録PDM出力、入力0での平均密度は0.5
) {
    var accumulator: logic<33>;

    assign pdm = accumulator[32];

    always_ff {
        if_reset {
            accumulator = 0;
        } else {
            let audio_unsigned: logic<32> = {~audio.raw[31], audio.raw[30:0]};
            accumulator    = (accumulator[31:0] as 33) + (audio_unsigned as 33);
        }
    }
}

/// 2次1bitデルタシグマ変調器
///
/// Q1.31入力を毎posedgeで取り込み、直後に登録PDMを更新する。
/// pdmを1=+1、0=-1として復調したときの利得は1/2で、フルスケール入力の平均密度は約0.25/0.75となる。
/// 微小ハイパスディザを使用するが、DC・微小入力でのトーン抑制は保証しない。
/// 状態overflow時はwrapし、過負荷の保護・通知は行わない。
/// reset中のpdm=0は復調値0ではないため、必要な出力ミュートは利用側で行う。
pub module DeltaSigma2nd #(
    param DITHER_SEED: u32 = 32'h1A2B_3C4D, /// ディザ乱数の非ゼロ初期値、resetで同じ系列を再現
) (
    clk  : input   clock                               , /// PDM更新クロック
    rst  : input   reset                               , /// 変調状態とpdmを0に初期化し、ディザ乱数系列を再開
    audio: modport FixedPointValue::<Q1_31>::input_port, /// 全32bitを使用するQ1.31入力（-1以上1未満）
    pdm  : output  logic                               , /// 毎clock更新する登録PDM出力
) {
    // 入力精度を維持しながら状態範囲[-32,32)を確保するため、小数32bit・全幅38bitを使う。
    // 中間値も同じ幅なので、範囲外の加減算は2の補数でwrapする。
    type State = signed logic<38>;

    var integrator_1: State;
    var integrator_2: State;

    // 帰還の±1を±2^32で表し、正負対称にして入力0の平均密度を0.5に保つ。
    const UNITY: State = 38'sd4294967296;

    var dither_prng    : logic<32>;
    var dither_previous: logic    ;

    always_ff {
        if_reset {
            integrator_1 = 0;
            integrator_2 = 0;
            dither_prng  = DITHER_SEED;
            // 初回の前後差を0にし、reset解除時にディザ由来の単発入力を作らない。
            dither_previous = DITHER_SEED[0];
            pdm             = 0;
        } else {
            // rawの小数点位置を1bit増やすことで、入力精度を落とさず1/2スケールにする。
            let x: State = $signed({audio.raw[31] repeat 6, audio.raw});

            // 0/4の乱数の前後差から、帰還基準の2^-30をピークとする微小HPディザを作る。
            // resetを挟まない区間では差分和が始点と終点の差となり、累積寄与は±4 LSB以内に収まる。
            let current : State = if dither_prng[0] ? 38'sd4 : 38'sd0;
            let previous: State = if dither_previous ? 38'sd4 : 38'sd0;
            let dither  : State = current - previous;

            // 前clockのpdmを両積分器へ帰還し、第2段にはこのclockのnext_1を渡す。
            // 帰還減算と入力・ディザ加算を並列に求め、加算器の直列段数を抑える。
            let feedback: State = if pdm ? UNITY : -UNITY;
            let next_1  : State = (integrator_1 - feedback) + (x + dither);
            let next_2  : State = (integrator_2 - feedback) + next_1;

            integrator_1 = next_1;
            integrator_2 = next_2;
            pdm          = ~next_2[37];

            // 右シフトGalois LFSRの更新にはedge前のLSBを使い、前回bitも同じ値で更新する。
            dither_previous = dither_prng[0];
            dither_prng     = (dither_prng >> 1) ^ (if dither_prng[0] ? 32'h8000_0057 : 32'd0);
        }
    }
}

// 1次デルタシグマ変調器の出力密度が入力振幅に追従することを検証
#[test(test_delta_sigma_1st_density)]
module test_delta_sigma_1st_density {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst zero_audio    : FixedPointValue::<Q1_31>;
    inst positive_audio: FixedPointValue::<Q1_31>;
    inst negative_audio: FixedPointValue::<Q1_31>;
    var zero_pdm     : logic   ;
    var positive_pdm : logic   ;
    var negative_pdm : logic   ;
    var zero_ones    : logic<8>;
    var positive_ones: logic<8>;
    var negative_ones: logic<8>;

    inst zero: DeltaSigma1st (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : zero_pdm  ,
    );
    inst positive: DeltaSigma1st (
        clk  : clk           ,
        rst  : rst           ,
        audio: positive_audio,
        pdm  : positive_pdm  ,
    );
    inst negative: DeltaSigma1st (
        clk  : clk           ,
        rst  : rst           ,
        audio: negative_audio,
        pdm  : negative_pdm  ,
    );

    always_ff (clk, rst) {
        if_reset {
            zero_ones     = 0;
            positive_ones = 0;
            negative_ones = 0;
        } else {
            if zero_pdm {
                zero_ones = zero_ones + 1;
            }
            if positive_pdm {
                positive_ones = positive_ones + 1;
            }
            if negative_pdm {
                negative_ones = negative_ones + 1;
            }
        }
    }

    initial {
        zero_audio.raw     = 0;
        positive_audio.raw = Q1_31::MAX;
        negative_audio.raw = Q1_31::MIN;
        rst.assert();
        clk.next(64);

        $assert(zero_ones >: 8'd24 && zero_ones <: 8'd40, "1st order zero density mismatch");
        $assert(positive_ones >: 8'd56, "1st order positive density is too low");
        $assert(negative_ones <: 8'd8, "1st order negative density is too high");
        $finish();
    }
}

// 2次デルタシグマ変調器の出力密度が入力振幅に追従することを検証
#[test(test_delta_sigma_2nd_density)]
module test_delta_sigma_2nd_density {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst zero_audio    : FixedPointValue::<Q1_31>;
    inst positive_audio: FixedPointValue::<Q1_31>;
    inst negative_audio: FixedPointValue::<Q1_31>;
    var zero_pdm     : logic   ;
    var positive_pdm : logic   ;
    var negative_pdm : logic   ;
    var zero_ones    : logic<8>;
    var positive_ones: logic<8>;
    var negative_ones: logic<8>;

    inst zero: DeltaSigma2nd (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : zero_pdm  ,
    );
    inst positive: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: positive_audio,
        pdm  : positive_pdm  ,
    );
    inst negative: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: negative_audio,
        pdm  : negative_pdm  ,
    );

    always_ff (clk, rst) {
        if_reset {
            zero_ones     = 0;
            positive_ones = 0;
            negative_ones = 0;
        } else {
            if zero_pdm {
                zero_ones = zero_ones + 1;
            }
            if positive_pdm {
                positive_ones = positive_ones + 1;
            }
            if negative_pdm {
                negative_ones = negative_ones + 1;
            }
        }
    }

    initial {
        zero_audio.raw     = 0;
        positive_audio.raw = Q1_31::MAX;
        negative_audio.raw = Q1_31::MIN;
        rst.assert();
        clk.next(128);

        $assert(zero_ones >: 8'd40 && zero_ones <: 8'd88, "2nd order zero density mismatch");
        $assert(positive_ones >: 8'd88, "2nd order positive density is too low");
        $assert(negative_ones <: 8'd40, "2nd order negative density is too high");
        $finish();
    }
}

// 2次デルタシグマ変調器がフルスケール入力で長時間stuckしないことを検証
//
// 復調利得は1/2のため、+MAXの密度は約0.75、MINは約0.25になる。
#[test(test_delta_sigma_2nd_full_scale)]
module test_delta_sigma_2nd_full_scale {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst positive_audio: FixedPointValue::<Q1_31>;
    inst negative_audio: FixedPointValue::<Q1_31>;
    var positive_pdm : logic;
    var negative_pdm : logic;
    var positive_ones: u16  ;
    var negative_ones: u16  ;

    inst positive: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: positive_audio,
        pdm  : positive_pdm  ,
    );
    inst negative: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: negative_audio,
        pdm  : negative_pdm  ,
    );

    always_ff (clk, rst) {
        if_reset {
            positive_ones = 0;
            negative_ones = 0;
        } else {
            if positive_pdm {
                positive_ones += 1;
            }
            if negative_pdm {
                negative_ones += 1;
            }
        }
    }

    initial {
        positive_audio.raw = Q1_31::MAX;
        negative_audio.raw = Q1_31::MIN;
        rst.assert();
        clk.next(4096);

        $assert(positive_ones >: 16'd2500 && positive_ones <: 16'd3600, "positive full-scale density mismatch");
        $assert(negative_ones >: 16'd500 && negative_ones <: 16'd1600, "negative full-scale density mismatch");
        $finish();
    }
}

// 1次デルタシグマ変調器の無音時アイドルトーンを検査するネイティブテスト
//
// 50MHzで44秒間（22億clock）を実行する。
// PDMを3段CICで1/1024に間引き、Rust verification componentで20Hzから20kHzの狭帯域トーンを検出する。
// 長時間のため通常のtestからは除外する。
#[test(test_delta_sigma_1st_idle_capture)]
#[ignore]
module test_delta_sigma_1st_idle_capture {
    const CAPTURE_CHUNKS: u32 = 22;
    const CHUNK_CYCLES  : u32 = 100_000_000;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst zero_audio: FixedPointValue::<Q1_31>;
    var pdm: logic;

    inst dut: DeltaSigma1st (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : pdm       ,
    );

    inst idle_tone_checker: $comp::idle_tone_checker (
        clk: clk,
        rst: rst,
        pdm: pdm,
    );

    initial {
        zero_audio.raw = 0;

        rst.assert();
        clk.next(4);

        for _ in 0..CAPTURE_CHUNKS {
            clk.next(CHUNK_CYCLES);
        }

        $finish();
    }
}

// 2次デルタシグマ変調器の無音時アイドルトーンを検査するネイティブテスト
//
// 50MHzで44秒間（22億clock）を実行する。
// PDMを3段CICで1/1024に間引き、Rust verification componentで20Hzから20kHzの狭帯域トーンを検出する。
// 長時間のため通常のtestからは除外する。
#[test(test_delta_sigma_2nd_idle_capture)]
#[ignore]
module test_delta_sigma_2nd_idle_capture {
    const CAPTURE_CHUNKS: u32 = 22;
    const CHUNK_CYCLES  : u32 = 100_000_000;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst zero_audio: FixedPointValue::<Q1_31>;
    var pdm: logic;

    inst dut: DeltaSigma2nd (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : pdm       ,
    );

    inst idle_tone_checker: $comp::idle_tone_checker (
